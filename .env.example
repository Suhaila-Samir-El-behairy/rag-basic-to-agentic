# Required
GROQ_API_KEY=gsk_...
HUGGINGFACEHUB_API_TOKEN=hf_...

# Optional: LangSmith tracing
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=rag-from-scratch-to-agentic

# Optional: switch LLM provider (requires: pip install -e ".[gemini]")
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=AIza...

# Optional: use Tavily instead of DuckDuckGo for web search (requires: pip install -e ".[tavily]")
# TAVILY_API_KEY=tvly-...
